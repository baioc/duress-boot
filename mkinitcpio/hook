#!/usr/bin/ash

run_hook() {
	local password retry line linenumber
	local version salt hash action options

	# TODO: plymouth prompts

	retry=1
	while [ "$retry" -eq 1 ]; do
		echo -n "A password is required to access the encrypted volume: "
		stty -echo
		read -r password
		stty echo
		echo ""

		linenumber=0
		while read -r line; do
			linenumber=$((linenumber + 1))
			case "$line" in
				'#'*) continue ;;
				''|[[:space:]]*) continue ;;
				*) ;;
			esac
			version=$(echo "$line" | cut -d',' -f1)
			case "$version" in
				v1)
					salt=$(echo "$line" | cut -d',' -f2)
					hash=$(echo "$line" | cut -d',' -f3)
					action=$(echo "$line" | cut -d',' -f4)
					options=$(echo "$line" | cut -d',' -f5-)
					if duress_v1 "$password" "$salt" "$hash" "$action" "$options"; then
						unset password
						return 0
					fi
					;;
				*)
					echo "Ignoring invalid duress configuration in line $linenumber ..." >&2
					continue
					;;
			esac
		done < ./duress.conf

		unset password

		echo -n "Retry [y/N] ? "
		read -r retry
		case "$retry" in
			y|Y) retry=1 ;;
			*) retry=0 ;;
		esac
	done

	return 0
}


duress_v1() {
	local password="$1" salt="$2" hash="$3" action="$4" options="$5"
	local computed

	computed=$(printf '%s%s' "$salt" "$password" | sha256sum | cut -d' ' -f1)
	if [ "$computed" != "$hash" ]; then
		return 1
	fi

	case "$action" in
		boot)
			echo "$hash -> $action($options)"
			return 0
			;;
		*)
			echo "Ignoring unknown duress action '$action' ..." >&2
			return 1
			;;
	esac
}



# TODO: replace ./ with / in actual hook also, echo .. >&2 with err "msg"

set -eu

run_hook
